Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^(?:database|includes|storage|geoip)(?:/|$) - [F,L]
RewriteRule ^install/defaults\.php$ - [F,L]
RewriteRule ^(?:\.env|config\.php|bootstrap\.php)$ - [F,L]

RewriteRule ^$ index.php [L]
RewriteRule ^login/?$ auth/login.php [L,QSA]
RewriteRule ^signup/?$ auth/signup.php [L,QSA]
RewriteRule ^logout/?$ auth/logout.php [L,QSA]
RewriteRule ^forgot-password/?$ auth/forgot-password.php [L,QSA]
RewriteRule ^reset-password/?$ auth/reset-password.php [L,QSA]
RewriteRule ^api/admin/plans/?$ api/admin/plans.php [L,QSA]
RewriteRule ^api/plans/?$ api/plans.php [L,QSA]
RewriteRule ^api/stats/?$ api/stats.php [L,QSA]
RewriteRule ^api/analytics/collect/?$ api/analytics/collect.php [L,QSA]
RewriteRule ^api/analytics/report/?$ api/analytics/report.php [L,QSA]
RewriteRule ^api/analytics/site/?$ api/analytics/site.php [L,QSA]
RewriteRule ^api/link-events/?$ api/link-events.php [L,QSA]
RewriteRule ^api/create-link/?$ api/create-link.php [L,QSA]
RewriteRule ^api/links/?$ api/links.php [L,QSA]
RewriteRule ^api/qr-design/?$ api/qr-design.php [L,QSA]
RewriteRule ^api/links/webhooks/?$ api/links.php?path=webhooks [L,QSA]
RewriteRule ^api/links/([0-9]+)/?$ api/links.php?path=$1 [L,QSA]
RewriteRule ^api/links/([0-9]+)/stats/?$ api/links.php?path=$1/stats [L,QSA]
RewriteRule ^api/files/?$ api/files.php [L,QSA]
RewriteRule ^api/storage-migrate/?$ api/storage-migrate.php [L,QSA]
RewriteRule ^api/media/?$ api/media.php [L,QSA]
RewriteRule ^api/share-management/?$ api/share-management.php [L,QSA]
RewriteRule ^api/upload-chunk/?$ api/upload-chunk.php [L,QSA]
RewriteRule ^api/code/?$ api/code.php [L,QSA]
RewriteRule ^code/?$ code/index.php [L,QSA]
RewriteRule ^code/([a-f0-9]{32})/?$ code/view.php?token=$1 [L,QSA]
RewriteRule ^qr/code-([a-f0-9]{32})/?$ qr/code.php?token=$1 [L,QSA]
RewriteRule ^api/files/(tokens|webhooks)/?$ api/files.php?path=$1 [L,QSA]
RewriteRule ^api/files/([0-9]+)(?:/(stats|analytics\.csv|complete))?/?$ api/files.php?path=$1/$2 [L,QSA]
RewriteRule ^files/trash/?$ files/trash/index.php [L,QSA]
RewriteRule ^files/?$ files/index.php [L,QSA]
RewriteRule ^share-management/?$ share-management/index.php [L,QSA]
RewriteRule ^media/?$ media/index.php [L,QSA]
RewriteRule ^file/download/?$ file/download/index.php [L,QSA]
RewriteRule ^file/share/([A-Za-z0-9_-]{8,64})/?$ file/share/index.php?token=$1 [L,QSA]
RewriteRule ^file/([A-Za-z0-9_-]{8,64})/?$ file/index.php?token=$1 [L,QSA]
RewriteRule ^admin/files/?$ admin/files.php [L,QSA]
RewriteRule ^api/ai-chat/?$ api/ai-chat.php [L,QSA]
RewriteRule ^service/ai/?$ api/ai-chat.php [L,QSA]
RewriteRule ^api/ai-action/?$ api/ai-action.php [L,QSA]
RewriteRule ^api/support/?$ api/support.php [L,QSA]
RewriteRule ^api/support-chat/?$ api/support-chat.php [L,QSA]
RewriteRule ^api/chat-upload/?$ api/chat-upload.php [L,QSA]
RewriteRule ^api/chat-attachment/?$ api/chat-attachment.php [L,QSA]
RewriteRule ^dashboard/?$ dashboard/index.php [L,QSA]
RewriteRule ^links/?$ links/index.php [L,QSA]
RewriteRule ^link-analytics/?$ links/analytics.php [L,QSA]
RewriteRule ^analytics/?$ analytics/index.php [L,QSA]
RewriteRule ^qr/file-([A-Za-z0-9_-]+)/?$ qr/file.php?token=$1 [L,QSA]
RewriteRule ^qr/([A-Za-z0-9_-]+)/?$ qr/index.php?slug=$1 [L,QSA]
RewriteRule ^link-preview/([A-Za-z0-9_-]+)/?$ links/og.php?code=$1 [L,QSA]
RewriteRule ^tasks/?$ tasks/index.php [L,QSA]
RewriteRule ^tasks/create/?$ tasks/create.php [L,QSA]
RewriteRule ^tasks/edit/?$ tasks/edit.php [L,QSA]
RewriteRule ^tasks/delete/?$ tasks/delete.php [L,QSA]
RewriteRule ^notes/?$ notes/index.php [L,QSA]
RewriteRule ^notes/create/?$ notes/create.php [L,QSA]
RewriteRule ^notes/edit/?$ notes/edit.php [L,QSA]
RewriteRule ^notes/delete/?$ notes/delete.php [L,QSA]
RewriteRule ^projects/?$ projects/index.php [L,QSA]
RewriteRule ^projects/create/?$ projects/create.php [L,QSA]
RewriteRule ^projects/edit/?$ projects/edit.php [L,QSA]
RewriteRule ^projects/delete/?$ projects/delete.php [L,QSA]
RewriteRule ^assistant/?$ ai/index.php [L,QSA]
RewriteRule ^assistant/chat/?$ ai/chat.php [L,QSA]
RewriteRule ^ai/?$ ai/index.php [L,QSA]
RewriteRule ^ai/chat/?$ ai/chat.php [L,QSA]
RewriteRule ^ai/transform-tasks/?$ ai/transform-tasks.php [L,QSA]
RewriteRule ^search/?$ search/index.php [L,QSA]
RewriteRule ^docs/?$ docs/index.php [L,QSA]
RewriteRule ^settings/?$ settings/index.php [L,QSA]
RewriteRule ^settings/ai/?$ settings/ai.php [L,QSA]
RewriteRule ^settings/link-api/?$ settings/link-api.php [L,QSA]
RewriteRule ^admin/version-details/?$ admin/version-details/index.php [L,QSA]
RewriteRule ^admin/ota-updater/?$ admin/ota-updater.php [L,QSA]
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/control-plane/?$ admin/control-plane.php [L,QSA]
RewriteRule ^admin/plans/?$ admin/plans.php [L,QSA]
RewriteRule ^admin/redirects/?$ admin/redirects.php [L,QSA]
RewriteRule ^admin/code-governance/?$ admin/code-governance.php [L,QSA]
RewriteRule ^admin/impersonate-stop/?$ admin/impersonate-stop.php [L,QSA]
RewriteRule ^admin/users/?$ admin/users.php [L,QSA]
RewriteRule ^admin/user-create/?$ admin/user-create.php [L,QSA]
RewriteRule ^admin/database/?$ admin/database.php [L,QSA]
RewriteRule ^admin/email/?$ admin/email.php [L,QSA]
RewriteRule ^admin/ai/?$ admin/ai.php [L,QSA]
RewriteRule ^admin/ai-users/?$ admin/ai-users.php [L,QSA]
RewriteRule ^admin/site-settings-save/?$ admin/site-settings-save.php [L,QSA]
RewriteRule ^admin/site-logo-upload/?$ admin/site-logo-upload.php [L,QSA]
RewriteRule ^admin/settings/?$ admin/settings.php [L,QSA]
RewriteRule ^admin/geoip/?$ admin/geo-providers.php [L,QSA]
RewriteRule ^admin/geo-providers/?$ admin/geo-providers.php [L,QSA]
RewriteRule ^admin/analytics/?$ admin/analytics.php [L,QSA]
RewriteRule ^admin/security/?$ admin/security.php [L,QSA]
RewriteRule ^admin/messages/?$ admin/messages.php [L,QSA]
RewriteRule ^admin/toggle/?$ admin/toggle.php [L,QSA]
RewriteRule ^admin/site-editor/?$ admin/site-editor.php [L,QSA]
RewriteRule ^admin/platform-activity/?$ admin/platform-activity.php [L,QSA]
RewriteRule ^admin/media/?$ admin/media.php [L,QSA]
RewriteRule ^admin/storage/oauth/?$ admin/storage/oauth.php [L,QSA]
RewriteRule ^admin/posts/?$ admin/posts.php [L,QSA]
RewriteRule ^admin/posts/edit/?$ admin/posts-edit.php [L,QSA]
RewriteRule ^admin/pages/?$ admin/pages.php [L,QSA]
RewriteRule ^admin/pages/edit/?$ admin/pages-edit.php [L,QSA]
RewriteRule ^admin/categories/?$ admin/categories.php [L,QSA]
RewriteRule ^admin/taxonomy-inline/?$ admin/taxonomy-inline.php [L,QSA]
RewriteRule ^admin/tags/?$ admin/tags.php [L,QSA]
RewriteRule ^admin/cache-purge/?$ admin/cache-purge.php [L,QSA]
RewriteRule ^admin/cms-preferences/?$ admin/cms-preferences.php [L,QSA]
RewriteRule ^admin/comments/?$ admin/comments.php [L,QSA]
RewriteRule ^admin/cms-preview/?$ admin/cms-preview.php [L,QSA]
RewriteRule ^admin/docs/?$ admin/docs.php [L,QSA]
RewriteRule ^admin/media-archive/?$ admin/media-archive.php [L,QSA]
RewriteRule ^admin/media-entry/?$ admin/media-entry.php [L,QSA]
RewriteRule ^admin/media-extract/?$ admin/media-extract.php [L,QSA]
RewriteRule ^admin/billing/?$ admin/billing.php [L,QSA]
RewriteRule ^admin/support/?$ admin/support.php [L,QSA]
RewriteRule ^billing/?$ billing/index.php [L,QSA]
RewriteRule ^billing/sandbox-checkout/?$ billing/sandbox-checkout.php [L,QSA]
RewriteRule ^support/?$ support/index.php [L,QSA]
RewriteRule ^support/proof/?$ support/proof.php [L,QSA]
RewriteRule ^support/file/?$ support/file.php [L,QSA]
RewriteRule ^share/([A-Za-z0-9]+)?/?$ share/index.php [L,QSA]
RewriteRule ^r/([A-Za-z0-9_-]{3,64})/?$ links/redirect.php?code=$1 [L,QSA]
RewriteRule ^install/?$ install/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_-]{3,64})/?$ links/redirect.php?code=$1 [L,QSA]
RewriteRule ^posts/?$ posts/index.php [L,QSA]
RewriteRule ^pages/?$ pages/index.php [L,QSA]
RewriteRule ^contact/?$ contact/index.php [L,QSA]
RewriteRule ^product/?$ product/index.php [L,QSA]
RewriteRule ^features/?$ features/index.php [L,QSA]
RewriteRule ^how-it-works/?$ how-it-works/index.php [L,QSA]
RewriteRule ^pricing/?$ pricing/index.php [L,QSA]
RewriteRule ^about/?$ about/index.php [L,QSA]
RewriteRule ^faq/?$ faq/index.php [L,QSA]
RewriteRule ^security/?$ security/index.php [L,QSA]
RewriteRule ^privacy/?$ privacy/index.php [L,QSA]
RewriteRule ^terms/?$ terms/index.php [L,QSA]
RewriteRule ^acceptable-use/?$ acceptable-use/index.php [L,QSA]
RewriteRule ^cookie-policy/?$ cookie-policy/index.php [L,QSA]
</IfModule>
<FilesMatch "^(\.env|\.env\.example|config\.php|bootstrap\.php|install/defaults\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
